# Add your OpenAI API key here
OPENAI_API_KEY=your-openai-api-key-here

DATABASE_URL=

# Metered TURN server credentials (server-side only - no NEXT_PUBLIC_ prefix)
# Sign up at https://www.metered.ca/ to get your API key
METERED_API_KEY=your-metered-api-key
METERED_APP_NAME=your-app-name

# Signalling Server URL (use wss:// for production)
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080

# Debug: set to `relay` to force TURN usage (helps verify TURN works even on same LAN)
NEXT_PUBLIC_WEBRTC_ICE_TRANSPORT_POLICY=all
